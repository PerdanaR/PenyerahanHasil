      const mobileList =
        document.getElementById(
          'historyList'
        );


      const body =
        document.getElementById(
          'historyBody'
        );


      mobileList.innerHTML = `

        <div class="loading">

          Memuat riwayat...

        </div>

      `;


      body.innerHTML = `

        <tr>

          <td
            colspan="8"
            class="loading">

            Memuat riwayat...

          </td>

        </tr>

      `;



      google.script.run


        .withSuccessHandler(
          function(data) {


            historyData =
              data || [];


            filterHistory();


          }
        )


        .withFailureHandler(
          function(error) {


            mobileList.innerHTML = `

              <div class="empty">

                Gagal memuat riwayat.

              </div>

            `;


            body.innerHTML = `

              <tr>

                <td
                  colspan="8"
                  class="empty">

                  Gagal memuat riwayat.

                </td>

              </tr>

            `;


            console.error(
              error
            );


          }
        )


        .getHistory();

    }



    // =====================================================
    // FILTER HISTORY
    // =====================================================

    function filterHistory() {


      const search =
        document
          .getElementById(
            'searchHistory'
          )
          .value
          .toLowerCase()
          .trim();


      const date =
        document
          .getElementById(
            'dateHistory'
          )
          .value;



      const filtered =
        historyData.filter(
          function(item) {


            const text = (

              item.namaPasien +
              ' ' +
              item.noRM +
              ' ' +
              item.jenis +
              ' ' +
              item.penerima +
              ' ' +
              item.hubungan +
              ' ' +
              item.petugas

            ).toLowerCase();



            const matchSearch =
              !search ||
              text.includes(
                search
              );


            const matchDate =
              !date ||
              item.tanggal ===
              date;


            return (
              matchSearch &&
              matchDate
            );

          }
        );



      renderHistory(
        filtered
      );

    }



