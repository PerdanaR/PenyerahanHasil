    // =====================================================
    // MULAI TANDA TANGAN
    // =====================================================

    function startSignature(
      index
    ) {


      if (
        index < 0 ||
        index >=
        pendingPatients.length
      ) {

        return;

      }


      currentPatientIndex =
        index;


      const patient =
        pendingPatients[index];


      const section =
        document.getElementById(
          'signatureSection'
        );


      section.style.display =
        'block';



      // ===================================================
      // ISI DATA
      // ===================================================

      document
        .getElementById(
          'namaPasien'
        )
        .value =
        patient.namaPasien;


      document
        .getElementById(
          'noRM'
        )
        .value =
        patient.noRM;


      document
        .getElementById(
          'jenis'
        )
        .value =
        patient.jenis;


      document
        .getElementById(
          'penerima'
        )
        .value =
        patient.penerima;


      document
        .getElementById(
          'hubungan'
        )
        .value =
        patient.hubungan;


      document
        .getElementById(
          'petugas'
        )
        .value =
        patient.petugas;



      // ===================================================
      // INFO SIGNATURE
      // ===================================================

      document
        .getElementById(
          'signingPatient'
        )
        .innerText =
        patient.namaPasien;


      document
        .getElementById(
          'signingInfo'
        )
        .innerText =
