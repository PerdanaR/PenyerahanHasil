        patient.noRM +
        ' • ' +
        patient.jenis;



      // ===================================================
      // SIAPKAN CANVAS
      // ===================================================

      setTimeout(
        function() {

          prepareCanvas();

        },
        80
      );



      // ===================================================
      // SCROLL
      // ===================================================

      setTimeout(
        function() {


          section.scrollIntoView({

            behavior: 'smooth',

            block: 'center'

          });


        },
        120
      );

    }



    // =====================================================
    // SIMPAN DATA
    // =====================================================

    function saveCurrentPatient() {


      if (
        currentPatientIndex ===
        -1
      ) {


        showPopup(
          'warning',
          'Pasien belum dipilih',
          'Silakan pilih pasien dari daftar terlebih dahulu.'
        );


        return;

      }


      if (
        isCanvasBlank()
      ) {


        showPopup(
          'warning',
          'Tanda tangan belum ada',
          'Silakan bubuhkan tanda tangan terlebih dahulu.'
        );


        return;

      }



      const patient =
        pendingPatients[
          currentPatientIndex
        ];



      const data = {

        namaPasien:
          patient.namaPasien,

        noRM:
          patient.noRM,

        jenis:
          patient.jenis,

        penerima:
          patient.penerima,

        hubungan:
          patient.hubungan,

        petugas:
          patient.petugas,

        ttd:
          canvas.toDataURL(
            'image/png'
          )

      };



      const button =
        document.getElementById(
          'saveSignatureBtn'
        );


      button.disabled =
        true;


      button.innerText =
        'Menyimpan...';



      // ===================================================
      // KIRIM KE APPS SCRIPT
      // ===================================================

      google.script.run


        .withSuccessHandler(
          function(result) {


            // Hapus pasien dari daftar

            pendingPatients.splice(
              currentPatientIndex,
              1
            );


            currentPatientIndex =
              -1;



            // Update daftar

            renderPendingPatients();



            // Bersihkan form

            clearPatientForm();



            // Sembunyikan signature

            document
              .getElementById(
                'signatureSection'
              )
              .style.display =
              'none';



            // Reset button

            button.disabled =
              false;


            button.innerText =
              'Simpan Tanda Tangan & Data';



            // Clear canvas

            clearPad();



            // Notifikasi

            showPopup(
              'success',
              'Berhasil disimpan',
              'Data pasien telah tersimpan ke Spreadsheet.'
            );


          }
        )


        .withFailureHandler(
          function(error) {


            button.disabled =
              false;


            button.innerText =
              'Simpan Tanda Tangan & Data';


            showPopup(
              'error',
              'Gagal menyimpan',
              error.message ||
              'Terjadi kesalahan saat menyimpan data.'
            );


          }
        )


        .submitData(
          data
        );

    }



    // =====================================================
    // HAPUS PASIEN
    // =====================================================

    function removePatient(
      index
    ) {


      if (
        index < 0 ||
        index >=
        pendingPatients.length
      ) {

        return;

      }


      const patient =
        pendingPatients[index];


      showPopup(
        'warning',
        'Hapus pasien?',
        'Pasien "' +
          patient.namaPasien +
          '" akan dihapus dari daftar sementara.',
        function() {

          deletePendingPatient(
            index
          );

        }
      );

    }



    // =====================================================
    // DELETE PASIEN
    // =====================================================

    function deletePendingPatient(
      index
    ) {


      if (
        index < 0 ||
        index >=
        pendingPatients.length
      ) {

        return;

      }



      if (
        currentPatientIndex ===
        index
      ) {


        currentPatientIndex =
          -1;


        document
          .getElementById(
            'signatureSection'
          )
          .style.display =
          'none';


        clearPad();

      }



      if (
        currentPatientIndex >
        index
      ) {

        currentPatientIndex--;

      }



      pendingPatients.splice(
        index,
        1
      );


      renderPendingPatients();


      showPopup(
        'success',
        'Pasien dihapus',
        'Pasien berhasil dihapus dari daftar sementara.'
      );

    }



