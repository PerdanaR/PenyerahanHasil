    // =====================================================
    // RESET FILTER
    // =====================================================

    function resetFilter() {


      document
        .getElementById(
          'searchHistory'
        )
        .value =
        '';


      document
        .getElementById(
          'dateHistory'
        )
        .value =
        '';


      filterHistory();

    }



    // =====================================================
    // ESCAPE HTML
    // =====================================================

    function escapeHTML(
      value
    ) {


      if (
        value === null ||
        value === undefined
      ) {

        return '';

      }


      return String(value)

        .replace(
          /&/g,
          '&amp;'
        )

        .replace(
          /</g,
          '&lt;'
        )

        .replace(
          />/g,
          '&gt;'
        )

        .replace(
          /"/g,
          '&quot;'
        )

        .replace(
          /'/g,
          '&#039;'
        );

    }



    // =====================================================
    // ESCAPE ATTRIBUTE
    // =====================================================

    function escapeAttribute(
      value
    ) {


      if (
        value === null ||
        value === undefined
      ) {

        return '';

      }


      return String(value)

        .replace(
          /"/g,
          '&quot;'
        )

        .replace(
          /'/g,
          '&#039;'
        );

    }



    // =====================================================
    // INIT
    // =====================================================

    renderPendingPatients();


  </script>


